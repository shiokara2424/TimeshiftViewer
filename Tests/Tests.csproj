<Project Sdk="Microsoft.NET.Sdk">
  <!-- Puyo/ のロジックだけを確認するコンソール。実行方法は CLAUDE.md を参照 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PuyoTests</AssemblyName>
    <RootNamespace>PuyoTests</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' And Exists('/usr/lib/mono/4.8-api')">
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Puyo\Tsumo.cs" Link="Puyo\Tsumo.cs" />
    <Compile Include="..\Puyo\Field.cs" Link="Puyo\Field.cs" />
    <Compile Include="..\Puyo\SimState.cs" Link="Puyo\SimState.cs" />
    <Compile Include="..\Puyo\Recognizer.cs" Link="Puyo\Recognizer.cs" />
    <Compile Include="..\Puyo\DigitTemplates.cs" Link="Puyo\DigitTemplates.cs" />
    <Compile Include="..\Puyo\DigitTemplates.Data.cs" Link="Puyo\DigitTemplates.Data.cs" />
    <Reference Include="System.Drawing" />
    <Compile Include="..\Puyo\NameOcr.cs" Link="Puyo\NameOcr.cs" />
    <Compile Include="..\Analyzer.cs" Link="Analyzer.cs" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>
</Project>
